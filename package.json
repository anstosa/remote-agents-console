{
  "name": "remote-agent-console",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @rac/server --filter @rac/web dev",
    "config:check": "pnpm --filter @rac/server config:check",
    "config:migrate": "pnpm --filter @rac/server config:migrate",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @rac/server test",
    "test:scripts": "node --test --test-concurrency=1 scripts/settings/*.test.mjs",
    "test:coverage": "pnpm --filter @rac/server test:coverage",
    "preview:share": "node scripts/share-preview.mjs",
    "start": "pnpm --filter @rac/server start"
  }
}
