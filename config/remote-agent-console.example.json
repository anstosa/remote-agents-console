{
  "listen": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "name": "My server",
  "publicOrigin": "http://127.0.0.1:8787",
  "scratchDirectory": "/home/me",
  "defaultAgent": "codex",
  "editor": "/usr/bin/nvim",
  "keys": { "root": { "C-g": { "table": "git" } }, "git": { "l": { "terminal": "lazygit", "reuse": true } } },
  "adapters": {
    "codex": {
      "program": "/usr/local/bin/codex",
      "args": ["-c", "check_for_update_on_startup=false"],
      "updates": {
        "current": "/usr/local/bin/codex --version | awk '{print $2}'",
        "latest": "npm view @openai/codex version",
        "run": "/usr/local/bin/codex update"
      }
    },
    "omx": {
      "program": "/usr/local/bin/omx",
      "args": ["-c", "check_for_update_on_startup=false"],
      "env": { "OMX_AUTO_UPDATE": "0" },
      "updates": {
        "current": "/usr/local/bin/omx version | sed -n '1s/^oh-my-codex v//p'",
        "latest": "npm view oh-my-codex version",
        "run": "/usr/local/bin/omx update --stable"
      }
    }
  },
  "projects": [
    {
      "id": "example",
      "label": "Example",
      "defaultBranch": "main",
      "path": "/home/me/code/example",
      "worktreesDirectory": "../example.worktrees",
      "commands": { "setup": "pnpm install", "processes": { "dev": "pnpm dev" } }
    }
  ],
  "review": {
    "agents": {
      "codex": { "mode": "headless" },
      "claude": { "mode": "interactive" }
    },
    "tour": {
      "agent": "codex",
      "effort": "low"
    },
    "defaultPreset": "correctness",
    "presets": [
      {
        "id": "correctness",
        "label": "Correctness",
        "agent": "codex",
        "effort": "high",
        "prompt": "Review these changes for bugs: logic errors, regressions, unhandled edge cases, broken error handling, and races. Report only real problems a reviewer should act on, not style preferences."
      },
      {
        "id": "security",
        "label": "Security",
        "agent": "codex",
        "effort": "xhigh",
        "prompt": "Review these changes for security problems: injection, missing authorization checks, secrets or sensitive data in logs or responses, unsafe file or process handling, and trust of unvalidated input."
      }
    ]
  }
}
