#!/bin/sh
# rac-attention — an Agent reports its Attention state to the Remote Agent Console
# by writing tmux pane options on its own pane (ADR 0001):
#
#   @rac_attention  working | finished | question
#   @rac_session    the agent's current session id (when known)
#   @rac_question   the base64 hook payload of a reported Inline question (ADR 0006)
#
# The console injects this script into Claude Code through per-launch hooks, and
# it is documented as an optional dotfile hook for sessions the console did not
# start. It never blocks the agent: it exits 0 in every case, doing nothing unless
# it is running inside a tmux pane and a tmux binary resolves.
#
# Usage: rac-attention <working|finished|question> [--session <id>] [--payload] [ignored...]
#
# The session defaults to $CLAUDE_CODE_SESSION_ID. With --payload, the hook's stdin
# (a PreToolUse JSON body) is base64-encoded into @rac_question so the console can
# render the question the Agent is asking. A working/finished report (no --payload)
# clears @rac_question, dropping a stale question once the Agent moves on; a bare
# question report leaves @rac_question intact, so a sibling question hook Claude fires
# alongside the AskUserQuestion PreToolUse hook cannot wipe the payload it just wrote.
# A payload over 64 KiB is dropped (the state is still reported). Extra arguments are
# ignored, so a hook that appends its own JSON argv (as Codex does) is harmless. tmux
# is resolved from $RAC_TMUX_BIN, else the first `tmux` on PATH.

state=$1
[ -n "$state" ] || exit 0
case $state in
  working|finished|question) ;;
  *) exit 0 ;;
esac
shift 2>/dev/null || true

session=${CLAUDE_CODE_SESSION_ID:-}
payload_flag=
lifecycle_event=
# read an explicit --session <id> and the --payload flag; ignore every other extra argument
while [ "$#" -gt 0 ]; do
  case $1 in
    --session) session=${2:-}; shift 2 2>/dev/null || shift ;;
    --session=*) session=${1#--session=}; shift ;;
    --payload) payload_flag=1; shift ;;
    --lifecycle) lifecycle_event=${2:-}; shift 2 2>/dev/null || shift ;;
    *) shift ;;
  esac
done

# nothing to report outside a tmux pane
[ -n "${TMUX_PANE:-}" ] || exit 0

# resolve tmux: an explicit RAC_TMUX_BIN wins, else the first on PATH
if [ -n "${RAC_TMUX_BIN:-}" ]; then
  tmux_bin=$RAC_TMUX_BIN
else
  tmux_bin=$(command -v tmux 2>/dev/null) || exit 0
fi
[ -n "$tmux_bin" ] || exit 0

# @rac_question carries the reported payload (base64, newlines stripped so the
# list-panes line stays tab-safe), empty unless --payload supplied a small-enough
# hook body. An oversize payload (over 64 KiB) is dropped; the state still reports.
question=
if [ -n "$payload_flag" ] || [ -n "$lifecycle_event" ]; then
  # retain at most one byte beyond the accepted hook payload bound
  raw=$(head -c 65537)
  raw_bytes=$(printf %s "$raw" | wc -c | tr -d ' ')
  if [ "$raw_bytes" -le 65536 ]; then
    question=$(printf %s "$raw" | base64 | tr -d '\n')
  else
    raw=
  fi
fi

# lifecycle correlation is opt-in through a short-lived opaque pane arm
if [ -n "$lifecycle_event" ]; then
  printf %s "$raw" | "$(dirname "$0")/rac-claude-lifecycle.mjs" "$lifecycle_event" >/dev/null 2>&1 || :
fi

# one tmux invocation sets @rac_attention, plus @rac_session when known. @rac_question
# is written only by a --payload report (the reported question); a working/finished
# report clears it (dropping a stale question once the Agent moves on), while a bare
# question report leaves it untouched — so a sibling question hook (Elicitation,
# PermissionRequest, Notification) that Claude fires alongside the AskUserQuestion
# PreToolUse hook cannot wipe the payload that hook just wrote.
set -- set-option -p -t "$TMUX_PANE" @rac_attention "$state"
if [ -n "$payload_flag" ]; then
  set -- "$@" \; set-option -p -t "$TMUX_PANE" @rac_question "$question"
elif [ "$state" != question ]; then
  set -- "$@" \; set-option -p -t "$TMUX_PANE" @rac_question ""
fi
if [ -n "$session" ]; then
  set -- "$@" \; set-option -p -t "$TMUX_PANE" @rac_session "$session"
fi
"$tmux_bin" "$@"
exit 0
