{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention finished --hook-input"
          },
          {
            "type": "command",
            "timeout": 5,
            "command": "node -e 'const instructions = process.env.RAC_RESPONSE_URL_INSTRUCTIONS;\n// an originless workspace must not inherit another workspace preference\nif (instructions) {\n  let input;\n  try { input = JSON.parse(require(\"node:fs\").readFileSync(0, \"utf8\")); } catch { process.exit(0); }\n  const event = input.hook_event_name;\n  // never emit context from a per-query event\n  if (event === \"SessionStart\" || event === \"SubagentStart\") {\n    process.stdout.write(JSON.stringify({ hookSpecificOutput: { hookEventName: event, additionalContext: instructions } }));\n  }\n}'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention working --hook-input --lifecycle start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention question --hook-input --payload --lifecycle question"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question --hook-input"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question --hook-input"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question --hook-input"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention working --hook-input --main-only"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention working --hook-input --main-only"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention working --hook-input --main-only"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention finished --hook-input --lifecycle terminal"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention finished --hook-input --lifecycle terminal"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question --hook-input"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention finished --hook-input"
          }
        ]
      }
    ]
  }
}
