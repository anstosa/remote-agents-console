{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention finished"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention working --lifecycle start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention question --payload --lifecycle question"
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question"
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention working --main-only"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention working --main-only"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention working --main-only"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention finished --lifecycle terminal"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux RAC_CALENDAR_LIFECYCLE_SPOOL=/srv/remoteagents/.data/google-calendar-claude-lifecycle.jsonl /srv/remoteagents/scripts/hooks/rac-attention finished --lifecycle terminal"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention question"
          }
        ]
      },
      {
        "matcher": "idle_prompt",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "RAC_TMUX_BIN=/usr/bin/tmux /srv/remoteagents/scripts/hooks/rac-attention finished"
          }
        ]
      }
    ]
  }
}
