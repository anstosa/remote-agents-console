{
  "name": "@rac/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "config:check": "tsx src/config/check.ts",
    "config:migrate": "tsx src/config/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@earendil-works/pi-codemode": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^9.3.0",
    "@fastify/websocket": "^11.0.1",
    "argon2": "^0.41.1",
    "croner": "10.0.1",
    "fastify": "^5.2.1",
    "semver": "^7.8.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/semver": "^7.8.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^3.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.4"
  }
}
