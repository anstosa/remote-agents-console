{
  "name": "@rac/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:e2e": "LD_LIBRARY_PATH=${XDG_CACHE_HOME:-$HOME/.cache}/playwright-system-libs/rootfs/usr/lib/x86_64-linux-gnu playwright test --output=/tmp/remoteagents-playwright-results-$USER",
    "screenshots:readme": "node scripts/capture-readme-screenshots.mjs"
  },
  "dependencies": {
    "@pierre/diffs": "1.4.3",
    "@prettier/plugin-xml": "3.4.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "prettier": "3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sh-syntax": "0.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
