[Unit]
Description=Remote Agent Console
Documentation=https://github.com/anstosa/remoteagents
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPOSITORY@
EnvironmentFile=@ENVIRONMENT_FILE@
Environment=NODE_ENV=production
Environment=PATH=@EXECUTABLE_PATH@
ExecStart=@NODE@ apps/server/dist/index.js --settings-control @SETTINGS_CONTROL@
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# No ProtectSystem= or other namespacing: in a user unit it implies a private
# user namespace where root-owned files appear owned by nobody, and ssh then
# rejects /etc/ssh config, breaking every in-process `git fetch` over SSH.
# /tmp must stay shared: launch descriptors are written to
# /tmp/remote-agent-console-<uid> and read back by the user's tmux server.
NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=default.target
