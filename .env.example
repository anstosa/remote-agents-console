# =============================================================================
# RAC core (every deployment: systemd/native and Docker Compose)
# =============================================================================
# Wrap values that contain "$" (the argon2 hash) in single quotes so neither the
# shell nor Docker Compose tries to expand them.

# Argon2id hash of the console login password. The argon2 package lives in
# apps/server, so run this from that directory:
#   cd apps/server && node -e "require('argon2').hash('change-me',{type:require('argon2').argon2id}).then(console.log)"
RAC_PASSWORD_HASH=

# Signs browser session cookies. Generate a unique value per instance:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
RAC_SESSION_SECRET=

# Shared HMAC secret that peer console instances (config `remoteServers`) use to
# sign /api/instance-status requests. Generate it the same way as
# RAC_SESSION_SECRET, then use the same value on every peer. Falls back to
# RAC_SESSION_SECRET when empty, so set it even for a single instance.
RAC_INSTANCE_STATUS_SECRET=

RAC_LOG_LEVEL=info

# server-local IANA timezone for queued-prompt note titles and schedules
# native and Docker Compose installs inherit the host timezone when unset
# set only to override the host's zone
# TZ=Etc/UTC

# Optional shell for sessions the console launches itself (container or direct);
# supported values are absolute zsh, bash, or fish paths.
RAC_INTERACTIVE_SHELL=/usr/bin/zsh

# optional exact api-key spend from OpenAI organization billing
# keep the privileged admin key server-side; ordinary api keys cannot read costs
RAC_OPENAI_ADMIN_KEY=
# map local saved-account ids to verified OpenAI billing api-key ids
# example: RAC_OPENAI_API_KEY_IDS='{"account-2":"key_example"}'
RAC_OPENAI_API_KEY_IDS=

# Optional ChatGPT MCP and Realtime voice integration.
RAC_OPENAI_API_KEY=
RAC_REALTIME_MCP_TOKEN=
# Use the same base64url-encoded 32-byte secret on federated servers.
# Falls back to RAC_INSTANCE_STATUS_SECRET when empty.
RAC_INTEGRATION_FEDERATION_SECRET=

# Optional Google Calendar integration. Configure a Google OAuth Web application
# with Calendar API enabled and the exact callback shown in Settings.
RAC_GOOGLE_CALENDAR_CLIENT_ID=
RAC_GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate locally: node -e "console.log('primary:'+require('crypto').randomBytes(32).toString('base64url'))"
RAC_GOOGLE_CALENDAR_TOKEN_KEY=
RAC_GOOGLE_CALENDAR_PREVIOUS_TOKEN_KEY=
# Native defaults; Compose supplies equivalent installation-local mounted paths.
RAC_GOOGLE_CALENDAR_AUTH_FILE=.data/google-calendar-auth.json
RAC_GOOGLE_CALENDAR_ACTIVITIES_FILE=.data/google-calendar-activities.json
RAC_GOOGLE_CALENDAR_LIFECYCLE_FILE=.data/google-calendar-lifecycle.json

# =============================================================================
# RAC through systemd (native host, see docs/systemd.md)
# =============================================================================
# The installer (scripts/install-systemd.sh) renders this file into the unit's
# EnvironmentFile. Docker Compose ignores RAC_CONFIG and points the container at
# /workspace/config/remote-agent-console.docker.json instead.

# Absolute path to the host-specific console config copied from
# config/remote-agent-console.example.json.
RAC_CONFIG=/absolute/path/remote-agent-console.json

# Optional overrides for the config file's "listen" block. Leave empty to use
# the config file (default 127.0.0.1:8787). The host must be a specific IP
# literal; wildcard binds (0.0.0.0, ::) are rejected. Anything beyond loopback
# exposes an unauthenticated-transport HTTP listener to that network, so keep
# it on a private interface (e.g. a Docker bridge gateway such as 172.19.0.1)
# and front it with HTTPS. Docker Compose uses host networking and also reads
# these values from this file.
RAC_LISTEN_HOST=
RAC_LISTEN_PORT=

# Directory shared with the host-side temporary preview helper. Relative paths
# resolve from the RAC working directory. Compose sets this to the mounted
# repository's ignored .data directory automatically.
RAC_TEMP_PREVIEWS_DIR=.data/temp-previews

# Absolute path to the tmux executable. The server never searches PATH; it
# defaults to /usr/bin/tmux, so set this when tmux is installed elsewhere (for
# example through mise or Homebrew). Use the real binary, not a version-manager
# shim, and point it at the same tmux that owns the sessions the console
# attaches to. Docker Compose sets this itself via HOST_TMUX_BIN below.
RAC_TMUX_BIN=

# =============================================================================
# RAC through Docker Compose (see docs/docker.md)
# =============================================================================
# Only read by compose.yaml and compose.override.yaml; leave at the defaults for
# a native install.

# Host the container uses to reach project preview ports; use 127.0.0.1 for
# Linux host networking.
RAC_PROJECT_PROXY_HOST=127.0.0.1

# Optional GitHub token when host CLI credentials are unavailable to the
# container (for example, gh stores its token in an OS credential store).
RAC_GITHUB_TOKEN=

# Optional host-tmux integration (enabled by compose.override.yaml).
# UID that owns the host tmux server.
HOST_UID=1000

# optionally pin the host Node.js executable for the full-host Files browser
# blank uses node from RAC_HOST_PATH or the host tmux PATH when not configured
# set an absolute executable path to override that lookup
# Files runs with the host tmux account's uid and supplementary groups
RAC_HOST_NODE_BIN=
# Host tmux executable or wrapper mounted into the container.
HOST_TMUX_BIN=/usr/bin/tmux
# Optional Codex executable visible to the host tmux server. Leave empty to use
# adapters.codex.program from the host-specific console config.
RAC_HOST_CODEX_BIN=
# Shell executed by the host tmux server and the complete PATH exported before
# host agent and stack commands.
RAC_HOST_INTERACTIVE_SHELL=/usr/bin/zsh
RAC_HOST_PATH=/usr/local/bin:/usr/bin:/bin

# =============================================================================
# Proxy container (cloudflared sidecar, Docker Compose `tunnel` profile only)
# =============================================================================
# The sidecar keeps an outbound Cloudflare Tunnel open so the loopback-only
# console is reachable over HTTPS. Start it with
# `docker compose --profile tunnel up -d --build` and pair it with
# config/cloudflared.yml (copied from config/cloudflared.example.yml).

# Absolute host path of the tunnel credentials JSON written by
# `cloudflared tunnel create`. Compose mounts it read-only at
# /etc/cloudflared/credentials.json.
CLOUDFLARED_CREDENTIALS_FILE=/absolute/path/.cloudflared/tunnel-uuid.json
